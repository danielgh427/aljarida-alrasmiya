sequenceDiagram
    autonumber
    actor U as User
    participant J as chatbot.js
    participant R as FastAPI
    participant RP as RagPipeline
    participant CH as ChromaDB
    participant MY as MySQL
    participant L as LLM

    U->>J: Types Arabic question
    J->>R: POST /ask {question, history}
    R->>RP: pipeline.ask()

    alt Question is Vague
        RP-->>J: Return "Clarify your question"
    else Question is Valid
        alt is_followup
            RP->>RP: Reuse previous context
        else is_new_query
            RP->>CH: Semantic Search (e5-small)
            CH-->>RP: Top-K document chunks
            RP->>MY: Fetch Metadata (Titles, Links)
            MY-->>RP: Row results
        end

        RP->>L: Prompt + Context + History
        L-->>RP: Generated Arabic Response
        RP-->>J: JSON {answer, sources}
        J->>U: Render Answer + Source Cards
    end
