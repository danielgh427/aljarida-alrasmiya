    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let page = $json.summary || \"\";\n\n// -------- Helper functions --------\n\n// Generic extractor\nfunction extract(regex) {\n  const match = page.match(regex);\n  return match ? match[1].trim() : null;\n}\n\n// Clean Arabic text\nfunction cleanText(text) {\n  if (!text) return null;\n  return text\n    .replace(/\\n+/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .replace(/[\\u200E\\u200F]/g, \"\") // remove hidden RTL chars\n    .trim();\n}\n\n// Convert to ISO date\nfunction toISO(dateString) {\n  if (!dateString) return null;\n  let d = new Date(dateString);\n  return isNaN(d) ? null : d.toISOString();\n}\n\n// Normalize price (extract number only)\nfunction normalizePrice(price) {\n  if (!price) return null;\n  let match = price.match(/[0-9.,]+/);\n  return match ? match[0].replace(/,/g, \"\") : null;\n}\n\n// -------- Extraction --------\n\n// Title\nlet title = extract(/ملخص الشراء\\s*([\\s\\S]*?)الموعد النهائي/);\nif (title) {\n  title = title.split(\"\\n\")[0];\n}\n\n// Summary\nlet summary = extract(/ملخص الشراء([\\s\\S]*?)الموعد النهائي/);\n\n// Dates\nlet finalDeadline = extract(/الموعد النهائي لتقديم العروض\\s*([0-9:\\-\\s]+)/);\nlet openingDate = extract(/موعد جلسة فتح العروض[\\s\\S]*?([0-9:\\-\\s]{16,})/);\n\n// Document price\nlet documentPrice = extract(/سعر دفتر الشروط\\s*([0-9.,\\sA-Z]+)/);\n\n// Document location\nlet documentLocation = extract(/مكان استلام دفتر الشروط([\\s\\S]*?)سعر دفتر الشروط/);\n\n// -------- Clean & Normalize --------\n\ntitle = cleanText(title);\nsummary = cleanText(summary);\ndocumentLocation = cleanText(documentLocation);\n\nfinalDeadline = toISO(finalDeadline);\nopeningDate = toISO(openingDate);\n\ndocumentPrice = normalizePrice(documentPrice);\n\n// -------- Return clean object --------\n\nreturn {\n  json: {\n    link: $json.link,\n    title,\n    summary,\n    final_submission_deadline: finalDeadline,\n    opening_session_date: openingDate,\n    document_price: documentPrice,\n    document_location: documentLocation\n  }\n};"
      },
