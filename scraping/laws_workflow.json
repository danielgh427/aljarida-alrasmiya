    {
      "parameters": {
        "jsCode": "const allLaws = [];\nconst baseUrl = \"http://77.42.251.205/\";\n\n// 1. Loop through all 10 pages received from the HTML node\nfor (const item of $input.all()) {\n  const pageData = item.json;\n  \n  // 2. Extract arrays for this specific page\n  const titles = pageData.title || [];\n  const types = pageData.law_type || [];\n  const numbers = pageData.law_number || [];\n  const dates = pageData.law_date || [];\n  const links = pageData.details_link || [];\n\n  // 3. Loop through the laws on this page and add them to our master list\n  for (let i = 0; i < titles.length; i++) {\n    allLaws.push({\n      json: {\n        title: titles[i],\n        law_type: types[i] || \"\",\n        law_number: numbers[i] || \"\",\n        law_date: dates[i] || \"\",\n        details_link: links[i] ? baseUrl + links[i] : \"\"\n      }\n    });\n  }\n}\n\n// 4. Return the complete list of ~200 items\nreturn allLaws;"
      },
